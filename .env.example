# Copy to .env before `make up`. Docker Compose reads .env automatically;
# .env itself is gitignored (CLAUDE.md §3.7 — secrets never enter the repo).

# HMAC key for the admit token. M1 signs with it, M2 verifies with it, so both
# services must be given the same value. Any non-empty string works for a local
# run; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AAAC_TOKEN_SECRET=dev-only-not-a-real-secret

# Optional run parameters. AAAC_RUN_ID names the event log (results/events-$ID.jsonl)
# and AAAC_MODE selects none | baseline | aaac for the origin.
# AAAC_RUN_ID=dev
# AAAC_MODE=none
# AAAC_SEED=1
